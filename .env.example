# Copy to .env, then paste your existing public Microsoft Application (Client) ID.
# Do not create or add a client secret. Process environment overrides this file.
MICROSOFT_CLIENT_ID=
MICROSOFT_ACCOUNT_TYPE=personal
MICROSOFT_REDIRECT_URI=http://localhost
MICROSOFT_SCOPES=User.Read Files.ReadWrite
EKM_STORAGE_PROVIDER=onedrive
# Optional: relocate all profiles and caches (never inside a Git repository).
# EKM_HOME=/absolute/path/to/private/ekm-data
